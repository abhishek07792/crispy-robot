# ─────────────────────────────────────────────────
# Database — PostgreSQL
# ─────────────────────────────────────────────────
# Full connection string (required by the backend).
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vapt_db

# ─────────────────────────────────────────────────
# Backend — Node.js / Express
# ─────────────────────────────────────────────────
BACKEND_PORT=3001

# Must be a long random string (≥ 32 chars).
JWT_SECRET=replace_with_a_long_random_secret_string_min32chars

# URL of the React frontend (used for CORS).
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────
# Analysis Engine — Python / Flask
# ─────────────────────────────────────────────────
# URL the backend uses to reach the analysis service.
ANALYSIS_SERVICE_URL=http://localhost:5001

# Shared secret between backend and analysis engine (must match on both sides).
ANALYSIS_SERVICE_SECRET=replace_with_internal_secret_for_analysis_service

# Port the Flask analysis service listens on.
ANALYSIS_PORT=5001

# ─────────────────────────────────────────────────
# Shodan API  (optional — leave blank for demo mode)
# ─────────────────────────────────────────────────
SHODAN_API_KEY=

# ─────────────────────────────────────────────────
# NVD CVE API  (optional — without key: 5 req/30s limit)
# ─────────────────────────────────────────────────
NVD_API_KEY=

# ─────────────────────────────────────────────────
# Development
# ─────────────────────────────────────────────────
# Set to true to show demo data on the dashboard when no Shodan key is present.
DEMO_MODE=true
NODE_ENV=development
